{
  "name": "private-memory-space",
  "private": true,
  "version": "0.1.0",
  "description": "A privacy-aware, instance-driven memorial story experience and local authoring studio.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiandewucimi-cpu/birthday-tomorrow-archive.git"
  },
  "bugs": {
    "url": "https://github.com/qiandewucimi-cpu/birthday-tomorrow-archive/issues"
  },
  "homepage": "https://github.com/qiandewucimi-cpu/birthday-tomorrow-archive#readme",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "prepare:instance": "node scripts/select-instance.mjs",
    "validate:instances": "node scripts/validate-instances.mjs",
    "test": "node --test --test-concurrency=1 scripts/instance-schema.test.mjs scripts/select-instance.test.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "typecheck": "node scripts/run-product.mjs typecheck",
    "dev": "node scripts/run-product.mjs dev",
    "build": "node scripts/run-product.mjs build",
    "preview": "vite preview --config vite.config.ts",
    "check": "pnpm validate:instances && pnpm test && pnpm privacy:check && pnpm build",
    "optimize:images": "python scripts/optimize-web-media.py"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
