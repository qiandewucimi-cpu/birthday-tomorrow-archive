{
  "name": "story-pages",
  "private": true,
  "version": "0.1.0",
  "description": "An instance-driven, chaptered storytelling page generator with a local authoring studio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiandewucimi-cpu/story-pages.git"
  },
  "bugs": {
    "url": "https://github.com/qiandewucimi-cpu/story-pages/issues"
  },
  "homepage": "https://github.com/qiandewucimi-cpu/story-pages#readme",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "prepare:instance": "node scripts/select-instance.mjs",
    "validate:instances": "node scripts/validate-instances.mjs",
    "test": "node --test --test-concurrency=1 scripts/instance-schema.test.mjs scripts/select-instance.test.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "typecheck": "node scripts/run-product.mjs typecheck",
    "dev": "node scripts/run-product.mjs dev",
    "build": "node scripts/run-product.mjs build",
    "preview": "vite preview --config vite.config.ts",
    "check": "pnpm validate:instances && pnpm test && pnpm privacy:check && pnpm build",
    "optimize:images": "python scripts/optimize-web-media.py"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  }
}
